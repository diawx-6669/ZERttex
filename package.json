{
  "name": "saryarqa-go",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open /app.html",
    "build": "tsc -b && vite build && node scripts/publish-pages.cjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:e2e": "npm run build && node tests/acceptance.cjs",
    "photos": "node scripts/fetch-photos.mjs",
    "report:docx": "node scripts/report-screenshots.cjs && node scripts/build-report-docx.cjs",
    "submission": "node scripts/build-submission.cjs",
    "sync:money": "node scripts/sync-money-docs.cjs",
    "photos:offline": "node scripts/photos-offline.cjs",
    "postcards": "node scripts/build-postcards.cjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "docx": "^9.14.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
